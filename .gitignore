# -----------------------------
# Laravel Core
# -----------------------------
/vendor/
/node_modules/

# Environment
.env
.env.*
!.env.example

# Laravel caches
bootstrap/cache/*.php
!bootstrap/cache/.gitignore

# Laravel logs
/storage/*.key
/storage/app/*.*
/storage/app/public/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*

# Ignore compiled php files
*.phpunit.result.cache

# -----------------------------
# Vite / Frontend Build
# -----------------------------
/public/build/
/public/hot
/public/storage

# NPM/Yarn
npm-debug.log
yarn-error.log
pnpm-debug.log

# -----------------------------
# IDE / Editor
# -----------------------------
.vscode/
.idea/
.DS_Store

# -----------------------------
# Composer / NPM lockfiles (if you want)
# -----------------------------
# composer.lock
# package-lock.json
# yarn.lock

# -----------------------------
# Docker ignore (local volumes)
# -----------------------------
/postgres/*
!/postgres/init-db.sql
/containerized/*
.vagrant/
